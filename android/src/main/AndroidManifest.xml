<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          Swap the native SDK's messaging service for the plugin's subclass.

          Both are registered for com.google.firebase.MESSAGING_EVENT, and
          Firebase binds whichever service the merged manifest happens to
          list first — so leaving both in place would make `DyplinkPush.tokens`
          work or not work depending on merge order. Removing the base one
          makes the choice explicit. Nothing is lost: the subclass calls
          through to it, so backend token registration, `delivered` reporting
          and the default notification all still happen.
        -->
        <service
            android:name="com.dyplink.push.DyplinkMessagingService"
            tools:node="remove" />

        <service
            android:name="com.dyplink.dyplink.DyplinkFlutterMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
